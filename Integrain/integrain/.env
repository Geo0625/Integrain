#--------------------------------------------------------------------
# Integrain - local environment (XAMPP defaults). Do NOT commit real secrets.
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

# Use the URL you open in the browser, with a trailing slash.
#   php spark serve                 -> http://localhost:8080/
#   XAMPP (htdocs/codeigniter4)     -> http://localhost/codeigniter4/public/
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.appTimezone = 'Asia/Manila'

database.default.hostname = localhost
database.default.database = integrain_db
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBCollat = utf8mb4_unicode_ci
database.default.port = 3306
database.default.numberNative = true

# Max failed logins within 15 minutes before an account is temporarily locked.
integrain.maxFailedLogins = 5
